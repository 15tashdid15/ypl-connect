generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  SUBMITTED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  SELECTED
  OFFER_SENT
  JOINED
  REJECTED
  ARCHIVED
}

model Candidate {
  id             String        @id @default(cuid())
  fullName       String        @db.VarChar(100)
  email          String        @unique @db.VarChar(150)
  phone          String        @db.VarChar(30)
  location       String        @db.VarChar(100)
  currentCompany String?       @db.VarChar(150)
  experience     String        @db.VarChar(50)
  portfolioUrl   String?       @db.VarChar(300)
  applications   Application[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([fullName])
  @@index([phone])
  @@map("candidates")
}

model Application {
  id             String            @id @default(cuid())
  referenceId    String            @unique @db.VarChar(40)
  jobSlug        String            @db.VarChar(160)
  jobTitle       String            @db.VarChar(200)
  coverLetter    String?           @db.Text
  status         ApplicationStatus @default(APPLIED)
  cvOriginalName String            @db.VarChar(255)
  cvMimeType     String            @db.VarChar(150)
  cvSize         Int
  cvStorageKey   String?           @db.VarChar(500)
  consentAt      DateTime
  candidateId    String
  candidate      Candidate         @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([candidateId, jobSlug])
  @@index([status])
  @@index([jobSlug])
  @@index([createdAt])
  @@map("applications")
}
