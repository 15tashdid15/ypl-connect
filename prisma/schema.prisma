generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Candidate {
  id                        String                     @id @default(cuid())
  fullName                  String                     @db.VarChar(100)
  email                     String                     @unique @db.VarChar(150)
  phone                     String                     @db.VarChar(30)
  location                  String                     @db.VarChar(100)
  currentCompany            String?                    @db.VarChar(150)
  experience                String                     @db.VarChar(50)
  portfolioUrl              String?                    @db.VarChar(300)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  applications              Application[]
  documents                 CandidateDocument[]
  searchProfile             CandidateSearchProfile?
  recruiterCandidateActions RecruiterCandidateAction[]

  @@index([fullName])
  @@index([phone])
  @@map("candidates")
}

model Job {
  id                        String                     @id @default(cuid())
  title                     String                     @db.VarChar(200)
  description               String
  companyName               String                     @db.VarChar(200)
  location                  String?                    @db.VarChar(150)
  employmentType            String?                    @db.VarChar(50)
  experienceRequired        Int?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  jobSearchProfile          JobSearchProfile?
  recruiterCandidateActions RecruiterCandidateAction[]

  @@index([title])
  @@index([companyName])
  @@map("jobs")
}

model Application {
  id             String                @id @default(cuid())
  referenceId    String                @unique @db.VarChar(40)
  jobSlug        String                @db.VarChar(160)
  jobTitle       String                @db.VarChar(200)
  coverLetter    String?
  status         ApplicationStatus     @default(APPLIED)
  cvOriginalName String                @db.VarChar(255)
  cvMimeType     String                @db.VarChar(150)
  cvSize         Int
  cvStorageKey   String?               @db.VarChar(500)
  consentAt      DateTime
  candidateId    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  activities     ApplicationActivity[]
  candidate      Candidate             @relation(fields: [candidateId], references: [id])

  @@unique([candidateId, jobSlug])
  @@index([status])
  @@index([jobSlug])
  @@index([createdAt])
  @@map("applications")
}

model User {
  id                    String                @id
  name                  String                @db.VarChar(100)
  email                 String                @unique @db.VarChar(150)
  emailVerified         Boolean               @default(false)
  image                 String?               @db.VarChar(500)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  accounts              Account[]
  applicationActivities ApplicationActivity[]
  sessions              Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.VarChar(100)
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(100)
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.VarChar(255)
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model ApplicationActivity {
  id             String                  @id @default(cuid())
  type           ApplicationActivityType
  message        String?
  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus?
  applicationId  String
  recruiterId    String
  recruiterName  String                  @db.VarChar(100)
  recruiterEmail String                  @db.VarChar(150)
  createdAt      DateTime                @default(now())
  application    Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recruiter      User                    @relation(fields: [recruiterId], references: [id])

  @@index([applicationId, createdAt])
  @@index([recruiterId, createdAt])
  @@index([type])
  @@map("application_activities")
}

model CandidateDocument {
  id             String                  @id @default(cuid())
  type           CandidateDocumentType   @default(CV)
  source         CandidateDocumentSource
  originalName   String                  @db.VarChar(255)
  mimeType       String                  @db.VarChar(150)
  size           Int
  storageKey     String                  @db.VarChar(500)
  objectETag     String?                 @db.VarChar(255)
  checksumSha256 String?                 @db.VarChar(64)
  candidateId    String
  uploadedAt     DateTime                @default(now())
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  candidate      Candidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  parseJobs      CvParseJob[]

  @@index([candidateId])
  @@index([storageKey])
  @@index([checksumSha256])
  @@map("candidate_documents")
}

model CvParseJob {
  id                  String            @id @default(cuid())
  status              CvParseJobStatus  @default(QUEUED)
  candidateDocumentId String
  attemptCount        Int               @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  errorMessage        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  extractedText       CvExtractedText?
  candidateDocument   CandidateDocument @relation(fields: [candidateDocumentId], references: [id], onDelete: Cascade)
  result              CvParseResult?

  @@index([candidateDocumentId])
  @@index([status])
  @@index([createdAt])
  @@map("cv_parse_jobs")
}

model CvExtractedText {
  id               String     @id @default(cuid())
  parseJobId       String     @unique
  extractedText    String
  extractionMethod String     @db.VarChar(50)
  pageCount        Int?
  characterCount   Int
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  parseJob         CvParseJob @relation(fields: [parseJobId], references: [id], onDelete: Cascade)

  @@index([characterCount])
  @@map("cv_extracted_texts")
}

model CvParseResult {
  id                   String         @id @default(cuid())
  parseJobId           String         @unique
  fullName             String?        @db.VarChar(100)
  headline             String?        @db.VarChar(200)
  summary              String?
  totalExperienceYears Int?
  skills               Json?
  education            Json?
  certifications       Json?
  languages            Json?
  extractedKeywords    Json?
  reviewStatus         CvReviewStatus @default(UNREVIEWED)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  experience           Json?
  seniority            String?        @db.VarChar(50)
  parseJob             CvParseJob     @relation(fields: [parseJobId], references: [id], onDelete: Cascade)

  @@index([reviewStatus])
  @@map("cv_parse_results")
}

model CandidateSearchProfile {
  id                   String    @id @default(cuid())
  candidateId          String    @unique
  searchableText       String
  skills               String[]
  keywords             String[]
  totalExperienceYears Int?
  highestEducation     String?   @db.VarChar(150)
  lastUpdatedAt        DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  embedding            Json?
  seniority            String?   @db.VarChar(50)
  candidate            Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([totalExperienceYears])
  @@map("candidate_search_profiles")
}

model AIConfiguration {
  id                  String      @id @default(cuid())
  provider            AIProvider  @default(LOCAL)
  fallbackEnabled     Boolean     @default(false)
  fallbackProvider    AIProvider?
  confidenceThreshold Int         @default(80)
  dailyTokenLimit     Int?
  monthlyTokenLimit   Int?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@map("ai_configuration")
}

model JobSearchProfile {
  id                   String   @id @default(cuid())
  jobId                String   @unique
  searchableText       String
  requiredSkills       String[]
  requiredExperience   Int?
  educationRequirement String?  @db.VarChar(150)
  embedding            Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  seniority            String?  @db.VarChar(50)
  job                  Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_search_profiles")
}

model RecruiterCandidateAction {
  id          String    @id @default(cuid())
  jobId       String
  candidateId String
  action      String    @db.VarChar(50)
  note        String?
  recruiterId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId, recruiterId])
  @@index([jobId])
  @@index([candidateId])
  @@map("recruiter_candidate_actions")
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  SUBMITTED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  SELECTED
  OFFER_SENT
  JOINED
  REJECTED
  ARCHIVED
}

enum ApplicationActivityType {
  STATUS_CHANGE
  NOTE
}

enum CandidateDocumentType {
  CV
  COVER_LETTER
  CERTIFICATE
  PORTFOLIO
  OTHER
}

enum CandidateDocumentSource {
  APPLICATION_UPLOAD
  RECRUITER_UPLOAD
  CANDIDATE_UPLOAD
  LEGACY_BACKFILL
}

enum CvParseStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CvParseTrigger {
  R2_EVENT
  MANUAL
  RETRY
  BACKFILL
}

enum CvReviewStatus {
  UNREVIEWED
  IN_REVIEW
  PARTIALLY_VERIFIED
  VERIFIED
  REJECTED
}

enum CvParseJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AIProvider {
  LOCAL
  GEMINI
  OPENAI
}
